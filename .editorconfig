# Khớp bộ luật Checkstyle của dự án (config/checkstyle/checkstyle.xml):
# Java thụt 4 dấu cách, tối đa 120 kí tự mỗi dòng, không tab.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 120

[*.{jsp,tag,jspf,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
