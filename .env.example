# Mẫu biến môi trường (giá trị GIẢ). Tạo .env thật: node scripts/dev/make-env.mjs
# Danh sách biến là SSOT ở plans/261111-tiem-thue-truyen/contract.md §4; thêm biến thì sửa cả hai trong một commit.
# .env thật bị ignore, không bao giờ commit.

# MySQL (service db)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=tiemtruyen
MYSQL_USER=tiemtruyen
MYSQL_PASSWORD=change-me-db

# Redis (service redis; session Tomcat qua Redisson)
REDIS_PASSWORD=change-me-redis

# Ứng dụng (service app)
APP_DB_URL=jdbc:mysql://db:3306/tiemtruyen?characterEncoding=UTF-8&connectionTimeZone=Asia/Ho_Chi_Minh
APP_DB_USER=tiemtruyen
APP_DB_PASSWORD=change-me-db
APP_DB_POOL_SIZE=10
APP_REDIS_ADDRESS=redis://redis:6379
APP_VITE_DEV=false
APP_VITE_DEV_ORIGIN=http://localhost:5173
APP_COVERS_BASE_URL=/covers
FLYWAY_DATA_LOCATION=filesystem:/flyway/data
LOGIN_RATE_MAX_FAILS=5
LOGIN_RATE_WINDOW_SECONDS=900

# Nginx (cổng trên máy, chỉ 127.0.0.1)
NGINX_HTTP_PORT=8080

# Múi giờ mọi service
TZ=Asia/Ho_Chi_Minh
